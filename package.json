{
  "name": "avr8js-electron-playground",
  "version": "0.21.1",
  "author": "arcostasi",
  "license": "MIT",
  "description": "An AVR8js and Wokwi Elements playground implemented with Electron.",
  "scripts": {
    "build": "tsc && vite build",
    "watch": "tsc -w",
    "start": "electron ./dist/main/main.js",
    "dev": "vite build && tsc && electron ./dist/main/main.js",
    "test": "vitest run",
    "test:perf-smoke": "vitest run src/main/project-io.perf.test.ts",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.1",
    "custom-electron-titlebar": "^4.4.1",
    "lucide-react": "^1.80.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "split.js": "^1.6.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
